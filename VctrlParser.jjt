options {
    STATIC = false;
    MULTI = true;
    VISITOR = true;
    NODE_DEFAULT_VOID = true;
    JDK_VERSION = "1.11";
    JAVA_UNICODE_ESCAPE = false;

    OUTPUT_DIRECTORY = "src/main/java/duongtran/vctrl/cli/parser";
    JJTREE_OUTPUT_DIRECTORY = "src/main/java/duongtran/vctrl/cli/parser";
}

PARSER_BEGIN(VctrlParser)
package duongtran.vctrl.cli.parser;

@SuppressWarnings("all")
public class VctrlParser {

    private static String stripQuotes(String s) {
        if (s == null || s.length() < 2) {
            return s;
        }
        if ((s.startsWith("\"") && s.endsWith("\""))
         || (s.startsWith("'") && s.endsWith("'"))) {
            return s.substring(1, s.length() - 1);
        }
        return s;
    }

}
PARSER_END(VctrlParser)

/* ====== SKIP ====== */
SKIP :
{
    " " | "\t" | "\n" | "\r"
}

/* ====== TOKENS ====== */
TOKEN :
{
      <K_INIT: "init">
    | <K_STATUS: "status">
    | <K_ADD: "add">
    | <K_COMMIT: "commit">
    | <K_LOG: "log">
    | <K_BRANCH: "branch">
    | <K_CHECKOUT: "checkout">
    | <K_MERGE: "merge">
    | <K_M: "-m"> // commit message
    | <K_D: "-d"> // remove branch
    | <K_B: "-b"> // create new branch

    | <ONELINE: "--oneline">
    | <PRETTY: "--pretty">
    | <FORMAT: "--format">
    | <GRAPH: "--graph">
    | <CARET: "^">
    | <DOTDOT: "..">
    | <EQUAL: "=">
}

/* Path / identifier */
TOKEN :
{
    <STRING_LITERAL: "\"" (~["\""])* "\"">
    | <FORMAT_STR: "\"" (~["\""])* "\"" | (~[" ", "\t", "\n", "\r"])+ >
    | <PATH: (~[" ", "\t", "\n", "\r", "^", "."])+ >
}

/* ====== ENTRY ====== */
ASTCommand command() #Command:
{}
{
    (
        init_cmd()
      | add_cmd()
      | commit_cmd()
      | status_cmd()
      | branch_cmd()
      | checkout_cmd()
      | log_cmd()
    )
    {
        return jjtThis;
    }
}
/* ====== COMMANDS ====== */

void init_cmd() #InitCommand :
{
    Token path = null;
}
{
    <K_INIT>
    ( path = <PATH> )?
    {
        if (path != null) {
            jjtThis.jjtSetValue(path.image);
        }
    }
}

void add_cmd() #AddCommand :
{
    Token path;
}
{
    <K_ADD>
    path = <PATH>
    {
        jjtThis.jjtSetValue(path.image);
    }
}

void commit_cmd() #CommitCommand :
{
    Token msg;
}
{
    <K_COMMIT>
    <K_M>
    msg = <STRING_LITERAL>
    {
        String m = msg.image;
        if (m.startsWith("\"") && m.endsWith("\"")) {
            m = m.substring(1, m.length() - 1);
        }
        jjtThis.jjtSetValue(m);
    }
}

void status_cmd() #StatusCommand :
{}
{
    <K_STATUS>
}

void branch_cmd() #BranchCommand :
{
    Token name = null; // branch's name
    boolean delete = false;
}
{
    <K_BRANCH>
    (
        <K_D> {delete = true;} name = <PATH>
        | name = <PATH>
    )?
    {
        BranchCommandData data = new BranchCommandData();
        data.name = name != null ? name.image : null;
        data.delete = delete;
        jjtThis.jjtSetValue(data);
    }
}

void checkout_cmd() #CheckoutCommand :
{
    Token name = null; // branch name
    boolean create = false;
}
{
    <K_CHECKOUT>
    (
        <K_B> {create = true;} name = <PATH>
        | name = <PATH>
    )?
    {
        CheckoutCommandData data = new CheckoutCommandData();
        data.name = name.image;
        data.create = create;
        jjtThis.jjtSetValue(data);
    }
}

void log_cmd() #LogCommand :
{

    LogRevisionSpec revSpec = new LogRevisionSpec();

    boolean oneline = false;
    boolean graph = false;
    String format = null;

    Token fmt = null;
    Token t1, t2;
}
{
    <K_LOG>

    /* -------- options -------- */
    (
        <ONELINE>     { oneline = true; }
      | <GRAPH>       { graph = true; }
      | ( (<PRETTY> | <FORMAT>) <EQUAL> fmt=<FORMAT_STR>
            { format = stripQuotes(fmt.image); }
        )
    )*

    /* -------- revision specs -------- */
    (
        /* ^branch */
        <CARET> t1=<PATH>
        {
            revSpec.exclude.add(t1.image);
        }

      | LOOKAHEAD( <PATH> <DOTDOT> )
        /* A..B */
        t1=<PATH> <DOTDOT> t2=<PATH>
        {
            revSpec.exclude.add(t1.image);
            revSpec.include.add(t2.image);
        }

      | LOOKAHEAD( <PATH> )
        /* normal branch */
        t1=<PATH>
        {
            revSpec.include.add(t1.image);
        }
    )*

    {
        LogCommandData data = new LogCommandData();
        data.oneline = oneline;
        data.graph = graph;
        data.format = format;
        data.revSpec = revSpec;

        jjtThis.jjtSetValue(data);
    }
}




