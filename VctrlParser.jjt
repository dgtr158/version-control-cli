options {
    STATIC = false;
    MULTI = true;
    VISITOR = true;
    NODE_DEFAULT_VOID = true;
    JDK_VERSION = "1.11";
    JAVA_UNICODE_ESCAPE = false;

    OUTPUT_DIRECTORY = "src/main/java/duongtran/vctrl/cli/parser";
    JJTREE_OUTPUT_DIRECTORY = "src/main/java/duongtran/vctrl/cli/parser";
}

PARSER_BEGIN(VctrlParser)
package duongtran.vctrl.cli.parser;

@SuppressWarnings("all")
public class VctrlParser {

    private static String stripQuotes(String s) {
        if (s == null || s.length() < 2) return s;
        if ((s.startsWith("\"") && s.endsWith("\""))
         || (s.startsWith("'") && s.endsWith("'"))) {
            return s.substring(1, s.length() - 1);
        }
        return s;
    }
}
PARSER_END(VctrlParser)

/* ===================== SKIP ===================== */
SKIP :
{
    " " | "\t" | "\n" | "\r"
}

/* ===================== KEYWORDS ===================== */
TOKEN :
{
      <K_INIT: "init">
    | <K_STATUS: "status">
    | <K_ADD: "add">
    | <K_COMMIT: "commit">
    | <K_LOG: "log">
    | <K_BRANCH: "branch">
    | <K_CHECKOUT: "checkout">
    | <K_MERGE: "merge">

    | <K_M: "-m">
    | <K_D: "-d">
    | <K_B: "-b">

    | <ONELINE: "--oneline">
    | <GRAPH: "--graph">
    | <PRETTY: "--pretty">
    | <FORMAT: "--format">

    | <CARET: "^">
    | <DOTDOT: "..">
    | <EQUAL: "=">
}

/* ===================== GENERIC ATOMS ===================== */
/*
 * ATOM is intentionally broad:
 * - branch names
 * - commit ids
 * - Linux paths
 * - Windows paths
 *
 * Meaning is decided in the parser, NOT the lexer.
 */
TOKEN :
{
    <QUOTED:
        "\"" (~["\""])* "\""
      | "'"  (~["'"])*  "'"
    >
  |
    <ATOM:
        (~[" ", "\t", "\n", "\r"])+
    >
}

/* ===================== ENTRY ===================== */
ASTCommand command() #Command :
{}
{
    (
        init_cmd()
      | add_cmd()
      | commit_cmd()
      | status_cmd()
      | branch_cmd()
      | checkout_cmd()
      | log_cmd()
    )
    { return jjtThis; }
}

/* ===================== COMMANDS ===================== */

void init_cmd() #InitCommand :
{
    Token path = null;
}
{
    <K_INIT>
    ( path=<ATOM> | path=<QUOTED> )?
    {
        if (path != null) {
            jjtThis.jjtSetValue(stripQuotes(path.image));
        }
    }
}

void add_cmd() #AddCommand :
{
    Token path;
}
{
    <K_ADD>
    ( path=<ATOM> | path=<QUOTED> )
    {
        jjtThis.jjtSetValue(stripQuotes(path.image));
    }
}

void commit_cmd() #CommitCommand :
{
    Token msg;
}
{
    <K_COMMIT>
    <K_M>
    msg=<QUOTED>
    {
        jjtThis.jjtSetValue(stripQuotes(msg.image));
    }
}

void status_cmd() #StatusCommand :
{}
{
    <K_STATUS>
}

void branch_cmd() #BranchCommand :
{
    Token name = null;
    boolean delete = false;
}
{
    <K_BRANCH>
    (
        <K_D> { delete = true; } ( name=<ATOM> | name=<QUOTED> )
      | ( name=<ATOM> | name=<QUOTED> )
    )?
    {
        BranchCommandData data = new BranchCommandData();
        data.name = name != null ? stripQuotes(name.image) : null;
        data.delete = delete;
        jjtThis.jjtSetValue(data);
    }
}

void checkout_cmd() #CheckoutCommand :
{
    Token name = null;
    boolean create = false;
}
{
    <K_CHECKOUT>
    (
        <K_B> { create = true; } ( name=<ATOM> | name=<QUOTED> )
      | ( name=<ATOM> | name=<QUOTED> )
    )?
    {
        CheckoutCommandData data = new CheckoutCommandData();
        data.name = name != null ? stripQuotes(name.image) : null;
        data.create = create;
        jjtThis.jjtSetValue(data);
    }
}

/* ===================== LOG ===================== */

void log_cmd() #LogCommand :
{
    LogRevisionSpec revSpec = new LogRevisionSpec();

    boolean oneline = false;
    boolean graph = false;
    String format = null;

    Token t1, t2, fmt;
}
{
    <K_LOG>

    /* -------- options -------- */
    (
        <ONELINE> { oneline = true; }
      | <GRAPH>   { graph = true; }
      | ( (<PRETTY> | <FORMAT>) <EQUAL> (fmt=<ATOM> | fmt=<QUOTED>)
            { format = stripQuotes(fmt.image); }
        )
    )*

    /* -------- revision specs -------- */
    (
        (t1=<ATOM> | t1=<QUOTED>)
        {
            String val = stripQuotes(t1.image);

            int dotdot = val.indexOf("..");
            if (dotdot >= 0) {
                String left  = val.substring(0, dotdot);
                String right = val.substring(dotdot + 2);

                if (!left.isEmpty()) {
                    revSpec.include.add(left);
                }
                if (!right.isEmpty()) {
                    revSpec.exclude.add(right);
                }
            } else if (val.startsWith("^")) {
                revSpec.exclude.add(val.substring(1));
            } else {
                revSpec.include.add(val);
            }
        }
    )*

    {
        LogCommandData data = new LogCommandData();
        data.oneline = oneline;
        data.graph = graph;
        data.format = format;
        data.revSpec = revSpec;
        jjtThis.jjtSetValue(data);
    }
}

